# ══════════════════════════════════════════════════════════════════
#  智慧文旅与交通建设 - 环境变量模板
#  复制为 .env 并填写真实值后启动
# ══════════════════════════════════════════════════════════════════

# ── 核心安全密钥 (必须修改！生产环境请使用强随机字符串) ──────────
SECRET_KEY=change-me-to-a-32-char-random-string
JWT_SECRET_KEY=change-me-to-another-32-char-random-string

# ── DeepSeek API (必须配置，否则 LLM 问答不可用) ─────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ── 高德地图 API (可选，影响实时 POI/天气/地图功能) ──────────────
AMAP_KEY=your-amap-key-here

# ── 数据库 (本地开发默认 SQLite，生产环境改为 PostgreSQL) ──────
# SQLite (本地开发):
DATABASE_URL=sqlite:///baiyun_culture.db

# PostgreSQL (生产环境):
# DATABASE_URL=postgresql+psycopg2://baiyun:your-password@localhost:5432/baiyun_culture
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baiyun_culture
DB_USER=baiyun
DB_PASSWORD=your-db-password-here

# ── Redis (缓存 + 限流 + Celery Broker) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_PREFIX=baiyun:

# ── Celery ────────────────────────────────────────────────────────
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── 限流 ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── CORS 白名单 (多个用逗号分隔) ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ── 嵌入式模型 (可选，留空则使用 TF-IDF 降级) ─────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── Ollama 本地回退 (可选) ────────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 功能开关 ──────────────────────────────────────────────────────
ENABLE_AGENTS=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RECOMMENDATION=true
ENABLE_REALTIME_DATA=false
ENABLE_EVALUATION=false
